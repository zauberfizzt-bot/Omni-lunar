{
  "name": "omni-lunar-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node cloudflare/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run build && node --check cloudflare/worker.mjs && wrangler deploy --dry-run --outdir /tmp/omni-worker-build"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
